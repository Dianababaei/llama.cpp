CREATE TABLE IF NOT EXISTS llama_bench (
    build_commit TEXT,
    build_number INTEGER,
    cpu_info TEXT,
    gpu_info TEXT,
    backends TEXT,
    model_filename TEXT,
    model_type TEXT,
    model_size INTEGER,
    model_n_params INTEGER,
    n_batch INTEGER,
    n_ubatch INTEGER,
    n_threads INTEGER,
    cpu_mask TEXT,
    cpu_strict INTEGER,
    poll INTEGER,
    type_k TEXT,
    type_v TEXT,
    n_gpu_layers INTEGER,
    n_cpu_moe INTEGER,
    split_mode TEXT,
    main_gpu INTEGER,
    no_kv_offload INTEGER,
    flash_attn INTEGER,
    devices TEXT,
    tensor_split TEXT,
    tensor_buft_overrides TEXT,
    use_mmap INTEGER,
    use_direct_io INTEGER,
    embeddings INTEGER,
    no_op_offload INTEGER,
    no_host INTEGER,
    fit_target INTEGER,
    fit_min_ctx INTEGER,
    n_prompt INTEGER,
    n_gen INTEGER,
    n_depth INTEGER,
    test_time TEXT,
    avg_ns INTEGER,
    stddev_ns INTEGER,
    avg_ts REAL,
    stddev_ts REAL,
    samples_ns TEXT,
    samples_ts TEXT
);

